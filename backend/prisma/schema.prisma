// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Webcam {
  id String   @id @default(uuid())
  youtubeVideoId String   @unique
  title String
  thumbnail String?
  city String?
  updatedAt DateTime @updatedAt
  @@map("webcams")
}

model Planes {
  id String   @id
  link String ?
  photographer String ?
  thumbnailSrc String ?
  thumbnailWidth Int ?
  thumbnailHeight Int ?

  createdAt     DateTime @default(now())
  @@map("planes")
}
